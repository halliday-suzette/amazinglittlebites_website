---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);

const PHONES = [
  { name: "Julio", display: "714-783-6605", href: "tel:+17147836605" },
  { name: "Nicole", display: "714-783-6615", href: "tel:+17147836615" },
];

const navLinks = [
  { href: "#home", label: t.nav.home },
  { href: "#services", label: t.nav.services },
  { href: "#menu", label: t.nav.menu },
  { href: "#service-area", label: t.nav.serviceArea },
  { href: "#quote", label: t.nav.quote },
  { href: "#contact", label: t.nav.contact },
];

const enHref = import.meta.env.BASE_URL;
const esHref = `${import.meta.env.BASE_URL}es/`;
---

<header class="sticky top-0 z-50 border-b border-blush/60 bg-cream/95 backdrop-blur">
  <div class="bg-maroon px-3 py-1 sm:px-6">
    <div class="mx-auto flex max-w-6xl items-center justify-end gap-1.5 font-body text-xs font-semibold">
      {lang === "en" ? (
        <span class="text-white">EN</span>
      ) : (
        <a href={enHref} aria-label={t.langToggle.switchAria} class="text-cream/70 transition hover:text-blush">
          EN
        </a>
      )}
      <span aria-hidden="true" class="text-cream/40">|</span>
      {lang === "es" ? (
        <span class="text-white">ES</span>
      ) : (
        <a href={esHref} aria-label={t.langToggle.switchAria} class="text-cream/70 transition hover:text-blush">
          ES
        </a>
      )}
    </div>
  </div>

  <nav class="mx-auto flex max-w-6xl items-center justify-between px-3 py-2 sm:px-6" aria-label="Primary">
    <a href="#home" class="flex shrink-0 items-center gap-2">
      <Image src={logo} alt={t.nav.logoAlt} width={48} height={48} class="h-12 w-12 shrink-0 object-contain" />
      <span class="whitespace-nowrap font-display text-base font-medium text-rose sm:text-xl">Amazing Little Bites</span>
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="font-body text-sm font-medium text-maroon transition hover:text-rose">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1.5 sm:gap-3">
      <div class="hidden items-center gap-2 sm:flex">
        {PHONES.map((phone) => (
          <a
            href={phone.href}
            title={t.nav.callAria(phone.name, phone.display)}
            class="inline-flex items-center rounded-full bg-rose px-4 py-2 font-body text-sm font-semibold text-white transition hover:bg-rose-dark"
          >
            📞 {phone.name}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-1 sm:hidden">
        {PHONES.map((phone) => (
          <a
            href={phone.href}
            aria-label={t.nav.callAria(phone.name, phone.display)}
            class="relative inline-flex h-8 w-8 items-center justify-center rounded-full bg-rose font-body text-xs font-semibold text-white transition before:absolute before:-inset-2 before:content-[''] hover:bg-rose-dark"
          >
            {phone.name.charAt(0)}
          </a>
        ))}
      </div>

      <button
        id="nav-toggle"
        type="button"
        class="relative inline-flex h-8 w-8 items-center justify-center rounded-md text-maroon before:absolute before:-bottom-2 before:-left-2 before:-top-2 before:right-0 before:content-[''] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.toggleMenuAria}
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" class="hidden flex-col gap-1 border-t border-blush/60 bg-cream px-4 pb-4 pt-2 lg:hidden">
    {navLinks.map((link) => (
      <li>
        <a href={link.href} class="mobile-nav-link block rounded-md px-3 py-2 font-body text-base font-medium text-maroon hover:bg-blush/40">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function closeMenu() {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  function toggleMenu() {
    const isOpen = !menu?.classList.contains("hidden");
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove("hidden");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      toggle?.setAttribute("aria-expanded", "true");
    }
  }

  toggle?.addEventListener("click", toggleMenu);
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
