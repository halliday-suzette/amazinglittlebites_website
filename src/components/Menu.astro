---
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);

const BARTENDING_ITEM = "Mobile Bartending / Mobile Coffee Cart";

const snackCarts = [
  "Mini-Pancakes Bar",
  "La Maruchan Bar",
  "Esquite Bar",
  "Tosti-Loco Bar (Cup/Bag)",
  "Ice Cream Sandwich Bar",
  "Chunky Brownie Sundae",
  "Charcuterie (Cheese) Board Bar",
  "Mini Churros Bar",
  "Little Taco Bar / Bacon Hot Dog Bar",
  BARTENDING_ITEM,
];

const hydrationBar = [
  "Mangonada",
  "Agua de Piña",
  "Agua de Fresa",
  "Agua de Pepino con Limón",
  "Agua de Tamarindo",
  "Agua de Horchata",
  t.menu.customAguaRequest,
];
---

<section id="menu" class="px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center font-display text-2xl font-bold text-rose sm:text-3xl">{t.menu.heading}</h2>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-blush/50 sm:p-8">
        <div class="flex items-center gap-3">
          <span class="text-3xl" aria-hidden="true">🍰</span>
          <h3 class="font-display text-xl font-semibold text-rose">{t.menu.snackCartsTitle}</h3>
        </div>
        <div class="mt-2 h-1 w-12 rounded-full bg-rose"></div>

        <ul class="mt-4 divide-y divide-blush/30">
          {snackCarts.map((item) => (
            <li class="flex items-start gap-2 py-2.5 font-body text-sm text-maroon/85 sm:text-base">
              <span class="mt-1 text-rose" aria-hidden="true">•</span>
              <span>
                {item}
                {item === BARTENDING_ITEM && (
                  <>
                    {" "}
                    <a href="#services" class="text-xs text-rose underline underline-offset-2 hover:text-rose-dark">
                      {t.menu.bartendingCrossRef}
                    </a>
                  </>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-blush/50 sm:p-8">
        <div class="flex items-center gap-3">
          <span class="text-3xl" aria-hidden="true">🥤</span>
          <h3 class="font-display text-xl font-semibold text-rose">{t.menu.hydrationBarTitle}</h3>
        </div>
        <div class="mt-2 h-1 w-12 rounded-full bg-rose"></div>

        <ul class="mt-4 divide-y divide-blush/30">
          {hydrationBar.map((item) => (
            <li class="flex items-start gap-2 py-2.5 font-body text-sm text-maroon/85 sm:text-base">
              <span class="mt-1 text-rose" aria-hidden="true">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mx-auto mt-8 max-w-2xl text-center font-body text-sm text-maroon/80 sm:text-base">
      {t.menu.note}
    </p>
  </div>
</section>
