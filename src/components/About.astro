---
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);
---

<section id="about" class="px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-display text-2xl font-bold text-rose sm:text-3xl">{t.about.heading}</h2>
    <p class="mt-4 font-body text-base leading-relaxed text-maroon/80 sm:text-lg">
      {t.about.body}
    </p>
  </div>
</section>
