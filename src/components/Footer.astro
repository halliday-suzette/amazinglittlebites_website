---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);

const PHONES = [
  { name: "Julio", display: "714-783-6605", href: "tel:+17147836605" },
  { name: "Nicole", display: "714-783-6615", href: "tel:+17147836615" },
];

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="bg-maroon px-4 py-12 text-cream sm:px-6">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center">
    <div class="flex items-center gap-3">
      <Image src={logo} alt={t.footer.logoAlt} width={48} height={48} class="h-12 w-12 object-contain" />
      <span class="font-display text-lg font-medium">Amazing Little Bites</span>
    </div>

    <div class="flex flex-col items-center gap-1">
      {PHONES.map((phone) => (
        <a href={phone.href} class="font-body text-base font-medium text-blush hover:underline">
          📞 {phone.name} — {phone.display}
        </a>
      ))}
    </div>

    <div class="font-body text-sm text-cream/80">
      <p class="font-semibold text-cream">{t.footer.serving}</p>
      <p>{t.footer.servingArea}</p>
    </div>

    <div class="font-body text-sm text-cream/80">
      <p class="font-semibold text-cream">{t.footer.office}</p>
      <p>Anaheim, CA</p>
      <a href="mailto:Amazinglittlebites24@outlook.com" class="text-blush hover:underline">
        Amazinglittlebites24@outlook.com
      </a>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://www.instagram.com/amazinglittle.bites"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.instagramAria}
        class="text-cream/80 transition hover:text-blush"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.97.24 2.43.4a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.16.46.35 1.26.4 2.43.06 1.25.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.24 1.97-.4 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.46.16-1.26.35-2.43.4-1.25.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.97-.24-2.43-.4a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.16-.46-.35-1.26-.4-2.43C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.24-1.97.4-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.6 1.8c.46-.16 1.26-.35 2.43-.4C9.28 1.34 9.68 1.33 12 1.33Zm0 1.8c-3.17 0-3.55 0-4.8.07-.96.04-1.48.2-1.82.33-.46.18-.79.4-1.13.74-.34.34-.56.67-.74 1.13-.13.34-.29.86-.33 1.82-.06 1.25-.07 1.63-.07 4.8s0 3.55.07 4.8c.04.96.2 1.48.33 1.82.18.46.4.79.74 1.13.34.34.67.56 1.13.74.34.13.86.29 1.82.33 1.25.06 1.63.07 4.8.07s3.55 0 4.8-.07c.96-.04 1.48-.2 1.82-.33.46-.18.79-.4 1.13-.74.34-.34.56-.67.74-1.13.13-.34.29-.86.33-1.82.06-1.25.07-1.63.07-4.8s0-3.55-.07-4.8c-.04-.96-.2-1.48-.33-1.82a3.1 3.1 0 0 0-.74-1.13 3.1 3.1 0 0 0-1.13-.74c-.34-.13-.86-.29-1.82-.33-1.25-.06-1.63-.07-4.8-.07Zm0 4.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88Zm0 8.14a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Zm6.3-8.34a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z" />
        </svg>
      </a>
      <a
        href="https://www.facebook.com/amazingLittle.bites?mibextid=wwXIfr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.facebookAria}
        class="text-cream/80 transition hover:text-blush"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />
        </svg>
      </a>
      <a
        href="https://www.tiktok.com/@amazinglittle.bites?_r=1&_t=ZP-98IDS9DxUoo"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.tiktokAria}
        class="text-cream/80 transition hover:text-blush"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.57h-3.15v14.02c0 1.55-1.26 2.8-2.8 2.8a2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.28 0 .55.04.8.12v-3.2a6.02 6.02 0 0 0-.8-.05A5.98 5.98 0 0 0 3.4 16.27a5.98 5.98 0 0 0 5.85 5.98 5.98 5.98 0 0 0 5.98-5.98V9.01a8.9 8.9 0 0 0 5.17 1.65V7.5a5.6 5.6 0 0 1-3.8-1.68Z" />
        </svg>
      </a>
      <a
        href="https://www.google.com/maps/place/Amazing+Little+Bites+Event+Management/@33.8350352,-118.5760035,239731m/data=!3m1!1e3!4m8!3m7!1s0x905bf781484bba5:0x6553770e0ef2a991!8m2!3d33.835649!4d-117.9166221!9m1!1b1!16s%2Fg%2F11zd56c_97"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.googleBusinessAria}
        class="text-cream/80 transition hover:text-blush"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C7.86 2 4.5 5.36 4.5 9.5c0 5.25 6.42 11.6 6.7 11.87a1.13 1.13 0 0 0 1.6 0c.28-.27 6.7-6.62 6.7-11.87C19.5 5.36 16.14 2 12 2Zm0 10.25a2.75 2.75 0 1 1 0-5.5 2.75 2.75 0 0 1 0 5.5Z" />
        </svg>
      </a>
    </div>

    <p class="font-body text-xs text-cream/70">
      {t.footer.copyright(currentYear)}
    </p>
    <p class="font-body text-xs text-cream/70">
      {t.footer.websiteBy}{" "}
      <a href="https://hallidayinc.com" target="_blank" rel="noopener noreferrer" class="text-blush hover:underline">
        Halliday
      </a>
    </p>
  </div>
</footer>
