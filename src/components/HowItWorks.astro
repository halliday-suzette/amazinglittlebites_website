---
const steps = [
  { number: "1", title: "Tell Us About Your Event", description: "Share your event date, type, and guest count." },
  { number: "2", title: "Choose Your Treats", description: "Pick your favorite bites from our customizable menu." },
  { number: "3", title: "We Bring the Cart, You Enjoy the Party", description: "We handle setup and serving so you can celebrate." },
];
---

<section class="bg-rose px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center font-display text-2xl font-bold text-white sm:text-3xl">How It Works</h2>

    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {steps.map((step) => (
        <div class="text-center text-white">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white font-display text-xl font-bold text-rose">
            {step.number}
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 font-body text-sm text-white/90">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
