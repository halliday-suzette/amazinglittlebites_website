---
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);

const steps = t.howItWorks.steps.map((step, i) => ({ number: String(i + 1), ...step }));
---

<section id="how-it-works" aria-labelledby="how-it-works-heading" class="bg-rose px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <h2 id="how-it-works-heading" class="text-center font-display text-2xl font-bold text-white sm:text-3xl">{t.howItWorks.heading}</h2>

    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {steps.map((step) => (
        <div class="text-center text-white">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white font-display text-xl font-bold text-rose">
            {step.number}
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 font-body text-sm text-white/90">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
