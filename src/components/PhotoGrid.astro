---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  heading: string;
  images: { src: ImageMetadata; alt: string }[];
}

const { heading, images } = Astro.props;
---

<section aria-labelledby="gallery-heading" class="px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <h2 id="gallery-heading" class="text-center font-display text-2xl font-bold text-rose sm:text-3xl">
      {heading}
    </h2>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {images.map((image) => (
        <div class="overflow-hidden rounded-2xl shadow-sm ring-1 ring-blush/50">
          <Image src={image.src} alt={image.alt} width={400} class="h-full w-full object-cover" />
        </div>
      ))}
    </div>
  </div>
</section>
