---
import { getDictionary, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDictionary(lang);

const PHONES = [
  { name: "J.C.", display: "714-783-6605", href: "tel:+17147836605" },
  { name: "Nicole", display: "714-783-6615", href: "tel:+17147836615" },
];
---

<section id="quote" class="bg-blush/20 px-4 py-14 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-center font-display text-2xl font-bold text-rose sm:text-3xl">{t.quoteForm.heading}</h2>
    <p class="mt-3 text-center font-body text-sm text-maroon/80 sm:text-base">
      {t.quoteForm.subheading}
    </p>
    <p class="mt-2 text-center font-body text-sm text-maroon/80 sm:text-base">
      {t.quoteForm.preferToCall}{" "}
      {PHONES.map((phone, i) => (
        <>
          <a href={phone.href} class="text-rose underline hover:text-rose-dark">
            📞 {phone.name}: {phone.display}
          </a>
          {i < PHONES.length - 1 && " · "}
        </>
      ))}
    </p>

    <form
      id="quote-form"
      action="https://formspree.io/f/mykrnkjz"
      method="POST"
      data-messages={JSON.stringify(t.quoteForm.messages)}
      class="mt-8 space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-blush/50 sm:p-8"
      novalidate
    >
      <!-- Honeypot field for spam protection (per Formspree convention) — keep hidden from real users -->
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="_subject" value="New Quote Request - Amazing Little Bites" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.name} *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          />
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>

        <div>
          <label for="phone" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.phone} *</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            placeholder="714-783-6605"
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          />
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>

        <div>
          <label for="email" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.email} *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          />
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>

        <div>
          <label for="event-date" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.eventDate} *</label>
          <input
            type="date"
            id="event-date"
            name="event_date"
            required
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          />
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>

        <div>
          <label for="event-type" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.eventType} *</label>
          <select
            id="event-type"
            name="event_type"
            required
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          >
            <option value="" disabled selected>{t.quoteForm.fields.selectEventType}</option>
            {t.quoteForm.eventTypes.map((type) => <option value={type.value}>{type.label}</option>)}
          </select>
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>

        <div>
          <label for="guest-count" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.guestCount} *</label>
          <input
            type="number"
            id="guest-count"
            name="guest_count"
            min="1"
            required
            class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
          />
          <p class="field-error mt-1 hidden font-body text-xs text-red-600"></p>
        </div>
      </div>

      <div>
        <label for="message" class="block font-body text-sm font-medium text-maroon">{t.quoteForm.fields.message}</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="mt-1 w-full rounded-lg border border-blush bg-cream px-3 py-2 font-body text-maroon focus:border-rose focus:outline-none focus:ring-1 focus:ring-rose"
        ></textarea>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full rounded-full bg-rose px-8 py-3 font-display text-base font-semibold text-white shadow-md transition hover:bg-rose-dark disabled:cursor-not-allowed disabled:opacity-60"
      >
        {t.quoteForm.submit}
      </button>

      <p id="form-status" class="hidden text-center font-body text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const statusEl = document.getElementById("form-status");

  interface FormMessages {
    required: string;
    invalidEmail: string;
    invalidPhone: string;
    fixErrors: string;
    sending: string;
    success: string;
    error: string;
  }

  const messages: FormMessages = JSON.parse(form?.dataset.messages ?? "{}");

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const PHONE_REGEX = /^[\d\s()+.-]{7,}$/;

  function showFieldError(input: HTMLElement, message: string) {
    const wrapper = input.closest("div");
    const errorEl = wrapper?.querySelector(".field-error");
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }
    input.classList.add("border-red-500");
  }

  function clearFieldError(input: HTMLElement) {
    const wrapper = input.closest("div");
    const errorEl = wrapper?.querySelector(".field-error");
    if (errorEl) {
      errorEl.textContent = "";
      errorEl.classList.add("hidden");
    }
    input.classList.remove("border-red-500");
  }

  function setStatus(message: string, isError: boolean) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-red-600", "text-green-700");
    statusEl.classList.add(isError ? "text-red-600" : "text-green-700");
  }

  function validate(): boolean {
    if (!form) return false;
    let isValid = true;

    form.querySelectorAll<HTMLElement>(".field-error").forEach(clearFieldError as unknown as (el: HTMLElement) => void);
    form.querySelectorAll("input, select").forEach((el) => clearFieldError(el as HTMLElement));

    const requiredFields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]");
    requiredFields.forEach((field) => {
      if (!field.value.trim()) {
        showFieldError(field, messages.required);
        isValid = false;
      }
    });

    const emailField = form.querySelector<HTMLInputElement>("#email");
    if (emailField?.value && !EMAIL_REGEX.test(emailField.value)) {
      showFieldError(emailField, messages.invalidEmail);
      isValid = false;
    }

    const phoneField = form.querySelector<HTMLInputElement>("#phone");
    if (phoneField?.value && !PHONE_REGEX.test(phoneField.value)) {
      showFieldError(phoneField, messages.invalidPhone);
      isValid = false;
    }

    return isValid;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    statusEl?.classList.add("hidden");

    if (!validate()) {
      setStatus(messages.fixErrors, true);
      return;
    }

    submitBtn.disabled = true;
    const originalText = submitBtn.textContent;
    submitBtn.textContent = messages.sending;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        setStatus(messages.success, false);
        form.reset();
      } else {
        setStatus(messages.error, true);
      }
    } catch {
      setStatus(messages.error, true);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
