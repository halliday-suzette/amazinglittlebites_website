---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amazing Little Bites | Dessert & Snack Cart Catering",
  description = "We know your sweet spot. Mobile dessert and snack cart catering for quinceañeras, sweet 16s, weddings, and birthdays across Orange County, San Bernardino, and Riverside.",
} = Astro.props;

const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}favicon.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d98ea3" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1179" />
    <meta property="og:image:height" content="822" />
    <meta property="og:image:alt" content="Amazing Little Bites logo — a pink dessert cart with an umbrella" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream font-body text-maroon antialiased">
    <slot />
  </body>
</html>
