---
import "../styles/global.css";
import { getDictionary, type Lang } from "../i18n/translations";
import { SNACK_CART_ITEMS } from "../data/menuItems";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = "en", title, description } = Astro.props;
const t = getDictionary(lang);

const resolvedTitle = title ?? t.meta.title;
const resolvedDescription = description ?? t.meta.description;

const enUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const esUrl = new URL(`${import.meta.env.BASE_URL}es/`, Astro.site);
const pageUrl = lang === "es" ? esUrl : enUrl;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, Astro.site);
const logoImageUrl = new URL(`${import.meta.env.BASE_URL}logo-512.png`, Astro.site);

const GBP_CID_URL = "https://www.google.com/maps?cid=7301310323161737617";

const businessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FoodEstablishment",
      "@id": "https://amazinglittlebites.com/#business",
      name: "Amazing Little Bites Event Management",
      alternateName: "Amazing Little Bites",
      legalName: "Amazing Little Bites Event Management",
      slogan: "We know your sweet spot",
      url: "https://amazinglittlebites.com/",
      description: t.meta.description,
      logo: {
        "@type": "ImageObject",
        "@id": "https://amazinglittlebites.com/#logo",
        url: logoImageUrl.toString(),
        width: 512,
        height: 512,
        caption: "Amazing Little Bites",
      },
      image: [ogImageUrl.toString()],
      telephone: "+17147836605",
      email: "Amazinglittlebites24@outlook.com",
      currenciesAccepted: "USD",
      knowsLanguage: ["en-US", "es-MX"],
      servesCuisine: ["Desserts", "Mexican", "Snacks"],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Anaheim",
        addressRegion: "CA",
        addressCountry: { "@type": "Country", name: "US" },
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 33.835649,
        longitude: -117.9166221,
      },
      hasMap: GBP_CID_URL,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Orange County, CA" },
        { "@type": "AdministrativeArea", name: "Los Angeles County, CA" },
        { "@type": "AdministrativeArea", name: "Riverside County, CA" },
        { "@type": "AdministrativeArea", name: "San Bernardino County, CA" },
      ],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "https://schema.org/Monday",
            "https://schema.org/Tuesday",
            "https://schema.org/Wednesday",
            "https://schema.org/Thursday",
            "https://schema.org/Friday",
            "https://schema.org/Saturday",
          ],
          opens: "11:00",
          closes: "20:00",
        },
      ],
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "sales",
          name: "Julio",
          telephone: "+17147836605",
          availableLanguage: ["en", "es"],
          areaServed: "US",
        },
        {
          "@type": "ContactPoint",
          contactType: "customer service",
          name: "Nicole",
          telephone: "+17147836615",
          availableLanguage: ["en", "es"],
          areaServed: "US",
        },
      ],
      sameAs: [
        "https://www.instagram.com/amazinglittle.bites",
        "https://www.facebook.com/amazingLittle.bites",
        "https://www.tiktok.com/@amazinglittle.bites",
        GBP_CID_URL,
      ],
      hasMenu: { "@id": "https://amazinglittlebites.com/#menu" },
      makesOffer: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Dessert & Snack Cart Catering",
            serviceType: "Event catering",
            description: "Mobile dessert and snack cart brought to your venue, set up and served on site.",
          },
        },
        {
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: "Quinceañera Catering", serviceType: "Event catering" },
        },
        {
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: "Wedding Dessert Cart", serviceType: "Event catering" },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Birthday & Sweet 16 Snack Cart",
            serviceType: "Event catering",
          },
        },
      ],
    },
    {
      "@type": "Menu",
      "@id": "https://amazinglittlebites.com/#menu",
      name: "Amazing Little Bites Cart Menu",
      inLanguage: "en-US",
      hasMenuSection: [
        {
          "@type": "MenuSection",
          name: "Snack Carts",
          hasMenuItem: SNACK_CART_ITEMS.map((item) => ({ "@type": "MenuItem", name: item })),
        },
        {
          "@type": "MenuSection",
          name: "Hydration Bar",
          hasMenuItem: [
            "Mangonada",
            "Agua de Piña",
            "Agua de Fresa",
            "Agua de Pepino con Limón",
            "Agua de Tamarindo",
            "Agua de Horchata",
          ].map((item) => ({ "@type": "MenuItem", name: item })),
        },
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://amazinglittlebites.com/#website",
      url: "https://amazinglittlebites.com/",
      name: "Amazing Little Bites",
      publisher: { "@id": "https://amazinglittlebites.com/#business" },
      inLanguage: ["en-US", "es-MX"],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#d98ea3" />

    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.hero.logoAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400..700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400..700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-QWaenrtT-XYAUD5cGXn6-.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="bg-cream font-body text-maroon antialiased">
    <slot />
  </body>
</html>
